# Example env for Dokploy → Environment (not committed with secrets).
#
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
# BETTER_AUTH_SECRET=<long random string>
# PAPERCLIP_DEPLOYMENT_MODE=authenticated
# PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# PAPERCLIP_PUBLIC_URL=https://paper.example.com
# PAPERCLIP_API_URL=https://paper.example.com
# PAPERCLIP_ALLOWED_HOSTNAMES=paper.example.com,127.0.0.1,localhost

DATABASE_URL=
BETTER_AUTH_SECRET=
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_PUBLIC_URL=
PAPERCLIP_API_URL=
PAPERCLIP_ALLOWED_HOSTNAMES=
